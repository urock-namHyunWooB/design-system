{
  "name": "@repo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "build:ir": "node ir/build.mjs",
    "generate": "node generator/generate.mjs",
    "pipeline": "pnpm build && pnpm build:ir && pnpm generate",
    "gen:quick": "pnpm build:ir && pnpm generate",
    "gen:clean": "pnpm clean && pnpm pipeline",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "validate": "node validate.js",
    "test": "npm run validate",
    "test:ir": "node tests/ir/button-ir.test.mjs",
    "test:components": "playwright test",
    "test:components:ui": "playwright test --ui",
    "test:components:headed": "playwright test --headed",
    "test:components:debug": "playwright test --debug",
    "test:all": "pnpm test:ir && pnpm test:components"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.56.1",
    "@playwright/test": "^1.56.1",
    "@repo/typescript-config": "workspace:*",
    "ajv": "^8.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2"
  }
}
