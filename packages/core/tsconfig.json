{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "parser/**/*",
    "token-resolver/**/*",
    "types/**/*",
    "DSL/**/*.ts",
    "ir/**/*",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
